<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_taxcloud" model="ir.ui.view">
        <field name="name">product.template.form.inherit.taxcloud</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Next to the sales taxes: the Accounting page needs a group Community users rarely have. -->
            <div name="taxes_div" position="after">
                <field name="taxcloud_tic" placeholder="From Category"
                       invisible="type == 'combo'" groups="account.group_account_invoice"/>
            </div>
        </field>
    </record>

    <record id="product_category_form_view_inherit_taxcloud" model="ir.ui.view">
        <field name="name">product.category.form.inherit.taxcloud</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <group name="first" position="after">
                <group string="TaxCloud" name="taxcloud" groups="account.group_account_invoice">
                    <field name="taxcloud_tic" placeholder="From Parent Category / Company"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
