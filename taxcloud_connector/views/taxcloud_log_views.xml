<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="taxcloud_log_view_list" model="ir.ui.view">
        <field name="name">taxcloud.log.list</field>
        <field name="model">taxcloud.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="level == 'error'">
                <field name="create_date" string="Date"/>
                <field name="level"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="status_code"/>
                <field name="attempt" optional="hide"/>
                <field name="duration_ms" optional="show"/>
                <field name="res_model" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="error_message" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="taxcloud_log_view_form" model="ir.ui.view">
        <field name="name">taxcloud.log.form</field>
        <field name="model">taxcloud.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Date"/>
                            <field name="level"/>
                            <field name="method"/>
                            <field name="endpoint"/>
                            <field name="status_code"/>
                        </group>
                        <group>
                            <field name="attempt"/>
                            <field name="duration_ms"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="error_message" invisible="not error_message" class="text-danger"/>
                    <notebook>
                        <page string="Request" name="request">
                            <field name="request_body" class="font-monospace"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_body" class="font-monospace"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="taxcloud_log_view_search" model="ir.ui.view">
        <field name="name">taxcloud.log.search</field>
        <field name="model">taxcloud.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="endpoint"/>
                <field name="error_message"/>
                <field name="res_model"/>
                <filter string="Errors" name="errors" domain="[('level', '=', 'error')]"/>
                <filter string="Info" name="info" domain="[('level', '=', 'info')]"/>
                <separator/>
                <filter string="Date" name="filter_create_date" date="create_date"/>
                <group>
                    <filter string="Endpoint" name="group_endpoint" context="{'group_by': 'endpoint'}"/>
                    <filter string="HTTP Status" name="group_status" context="{'group_by': 'status_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_taxcloud_log" model="ir.actions.act_window">
        <field name="name">TaxCloud Logs</field>
        <field name="res_model">taxcloud.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="taxcloud_log_view_search"/>
    </record>

    <menuitem id="menu_taxcloud_log"
              name="TaxCloud Logs"
              parent="account.menu_finance_configuration"
              action="action_taxcloud_log"
              groups="account.group_account_manager"
              sequence="100"/>
</odoo>
