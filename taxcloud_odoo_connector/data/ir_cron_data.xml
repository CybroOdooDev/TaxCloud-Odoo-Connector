<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_taxcloud_purge_logs" model="ir.cron">
        <field name="name">TaxCloud: Purge old API logs</field>
        <field name="model_id" ref="model_taxcloud_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_taxcloud_report" model="ir.cron">
        <field name="name">TaxCloud: Report invoices and refunds</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_taxcloud_report()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
