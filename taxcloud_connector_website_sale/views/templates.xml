<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TaxCloud taxes depend on the delivery address and method: show them from the payment step on. -->
    <template id="order_tax_lines" inherit_id="website_sale.order_tax_lines">
        <tr name="o_order_total_taxes" position="attributes">
            <attribute name="t-att-style">'display: none;' if not on_payment_step and website_sale_order.is_taxcloud_computed else ''</attribute>
        </tr>
    </template>
    <template id="total" inherit_id="website_sale.total">
        <tr name="o_order_total" position="attributes">
            <attribute name="t-att-style">'display: none;' if not on_payment_step and website_sale_order.is_taxcloud_computed else ''</attribute>
        </tr>
        <tr name="o_order_total_untaxed" position="attributes">
            <attribute name="t-if" add="(not on_payment_step and website_sale_order.is_taxcloud_computed)" separator="or"/>
        </tr>
    </template>
</odoo>
