<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_taxcloud" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.taxcloud</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="so_button_below_order_lines" position="attributes">
                <attribute name="invisible">0</attribute>
            </div>
            <div name="so_button_below_order_lines" position="inside">
                <field name="is_taxcloud_computed" invisible="1"/>
                <button name="action_taxcloud_compute_taxes"
                        type="object"
                        string="Compute Taxes"
                        invisible="locked or state == 'cancel' or not is_taxcloud_computed"
                        groups="sales_team.group_sale_salesman,account.group_account_invoice"/>
            </div>
            <xpath expr="//field[@id='document_tax_mode_mobile']" position="attributes">
                <attribute name="invisible" add="is_taxcloud_computed" separator="or"/>
            </xpath>
            <xpath expr="//field[@id='document_tax_mode']" position="attributes">
                <attribute name="invisible" add="is_taxcloud_computed" separator="or"/>
            </xpath>
        </field>
    </record>
</odoo>
